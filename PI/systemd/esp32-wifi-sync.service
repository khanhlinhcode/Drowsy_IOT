[Unit]
Description=ESP32 WiFi Sync Bridge (Serial -> Pi WiFi)
After=NetworkManager.service network-online.target multi-user.target
Wants=network-online.target
Requires=NetworkManager.service

[Service]
Type=simple
WorkingDirectory=__WORKDIR__
ExecStart=__PYTHON_BIN__ __WORKDIR__/esp32_wifi_bridge.py
Restart=always
RestartSec=2
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=process
Environment=ESP32_WIFI_SERIAL_PORT=__ESP32_WIFI_SERIAL_PORT__
Environment=ESP32_WIFI_SERIAL_BAUD=__ESP32_WIFI_SERIAL_BAUD__
Environment=AUTO_SERIAL_DISCOVERY=__AUTO_SERIAL_DISCOVERY__
Environment=PI_WIFI_INTERFACE=__PI_WIFI_INTERFACE__
Environment=WIFI_LOCK_TO_ESP32=__WIFI_LOCK_TO_ESP32__
Environment=WIFI_REQUIRE_ESP32_TARGET=__WIFI_REQUIRE_ESP32_TARGET__
Environment=NO_TARGET_DISCONNECT_COOLDOWN_MS=__NO_TARGET_DISCONNECT_COOLDOWN_MS__
Environment=WIFI_HARD_LOCK_RADIO=__WIFI_HARD_LOCK_RADIO__
Environment=WIFI_RADIO_TOGGLE_GAP_MS=__WIFI_RADIO_TOGGLE_GAP_MS__
Environment=WIFI_ENFORCE_RECONNECT_GAP_MS=__WIFI_ENFORCE_RECONNECT_GAP_MS__
Environment=WIFI_MISMATCH_HOLD_MS=__WIFI_MISMATCH_HOLD_MS__
Environment=WIFI_LOCK_CHECK_MS=__WIFI_LOCK_CHECK_MS__
Environment=ESP32_TARGET_WAIT_GRACE_MS=__ESP32_TARGET_WAIT_GRACE_MS__
Environment=ESP32_TARGET_LOSS_GRACE_MS=__ESP32_TARGET_LOSS_GRACE_MS__
Environment=ESP32_SERIAL_OFFLINE_GRACE_MS=__ESP32_SERIAL_OFFLINE_GRACE_MS__
Environment=KEEP_LAST_TARGET_WHEN_SERIAL_OFFLINE=__KEEP_LAST_TARGET_WHEN_SERIAL_OFFLINE__
Environment=WIFI_CONNECT_WAIT_S=__WIFI_CONNECT_WAIT_S__
Environment=WIFI_CONNECT_TIMEOUT_S=__WIFI_CONNECT_TIMEOUT_S__
Environment=WIFI_FAIL_RECOVER_AFTER=__WIFI_FAIL_RECOVER_AFTER__
Environment=WIFI_FAIL_RECOVER_COOLDOWN_MS=__WIFI_FAIL_RECOVER_COOLDOWN_MS__
Environment=ESP32_SYNC_REQUEST_INTERVAL_MS=__ESP32_SYNC_REQUEST_INTERVAL_MS__
Environment=NO_TARGET_FORCE_SERIAL_REOPEN_MS=__NO_TARGET_FORCE_SERIAL_REOPEN_MS__
Environment=MQTT_BROKER=__MQTT_BROKER__
Environment=MQTT_PORT=__MQTT_PORT__
Environment=BROKER_HINT_INTERVAL_S=__BROKER_HINT_INTERVAL_S__
Environment=SERIAL_REOPEN_MIN_S=__SERIAL_REOPEN_MIN_S__
Environment=SERIAL_REOPEN_MAX_S=__SERIAL_REOPEN_MAX_S__
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
